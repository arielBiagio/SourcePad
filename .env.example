OPENROUTER_API_KEY=
# La misma clave se usa para embeddings BGE-M3. No reemplazar el modelo de chat por un embedding.
# baai/bge-m3 (1024 dimensiones) está fijado en código + migración 004; cambiarlo exige versionar/reindexar.
# Generación de pago; no hay llamadas al iniciar ni cambio automático de modelo.
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-flash

# legacy conserva Better Auth/SQLite. Cambiar explícitamente cuando conectes Supabase.
AUTH_PROVIDER=legacy
PORT=3000
APP_URL=http://localhost:3000

# Supabase > Connect / Project settings > API keys. Usar publishable o anon.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MAX_UPLOAD_BYTES=10485760
# SUPABASE_ANON_KEY= (alternativa para proyectos con clave anon)

# Sólo para el sistema anterior:
# Generar un valor aleatorio de al menos 32 caracteres si se usa legacy.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
